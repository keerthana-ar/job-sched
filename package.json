{
  "name": "aethersched",
  "version": "1.0.0",
  "description": "Fault-tolerant distributed job scheduler with atomic lookahead, lease-based execution, chaos resilience, and live observability",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:scheduler": "tsx src/bin/scheduler.ts",
    "start:worker": "tsx src/bin/worker.ts",
    "start:reaper": "tsx src/bin/reaper.ts",
    "start:cluster": "tsx src/bin/cluster.ts",
    "start:api": "tsx src/index.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "keywords": [
    "distributed-systems",
    "job-scheduler",
    "concurrency",
    "fault-tolerance",
    "redis",
    "system-design"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cron-parser": "^4.9.0",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
