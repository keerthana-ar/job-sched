    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Execution Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(aethersched_job_execution_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aethersched_job_execution_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(aethersched_job_execution_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Jobs Dispatched by Scheduler Node",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(aethersched_jobs_dispatched_total[1m])) by (scheduler_id)",
          "legendFormat": "{{scheduler_id}}",
          "refId": "A"
        }
      ]
    }
